{
  "name": "future-conquest",
  "version": "0.1.0",
  "private": true,
  "description": "Design data and tooling for the Future Conquest strategy game.",
  "type": "module",
  "scripts": {
    "predev": "npm run build:r3-europe-land-mask && npm run build:r3-physical-terrain && npm run build:audio && npm run build:motion-comic && npm run build:endings",
    "dev": "vite",
    "test": "node scripts/run-engine-tests.mjs",
    "simulate:current-balance": "node scripts/simulate-current-engine-balance.mjs",
    "simulate:board-playtest": "node scripts/simulate-board-playtest-matrix.mjs",
    "benchmark:r3-renderer": "node scripts/benchmark-r3-renderer-spike.mjs",
    "performance:r3-wp2e": "node scripts/run-r3-wp2e-performance.mjs",
    "build:slice-map": "node scripts/build-vertical-slice-map.mjs",
    "build:audio": "node scripts/build-audio-assets.mjs",
    "build:motion-comic": "node scripts/repair-page2-bundle-tail.mjs && node scripts/build-title-card-asset.mjs && node scripts/build-motion-comic-assets.mjs",
    "build:endings": "node scripts/build-ending-assets.mjs",
    "build:r3-europe-land-mask": "node scripts/maps/build-r3-europe-land-mask.mjs",
    "build:r3-physical-terrain": "node scripts/maps/materialise-r3-physical-terrain-texture.mjs",
    "build:landmark-miniatures": "node scripts/build-r3-landmark-miniature-assets.mjs && node scripts/build-r3-landmark-miniature-assets-extra.mjs && node scripts/build-r3-landmark-miniature-assets-pass2.mjs && node scripts/build-r3-landmark-miniature-assets-pass3.mjs && node scripts/build-r3-landmark-miniature-assets-pass4.mjs && node scripts/build-r3-landmark-miniature-assets-pass5.mjs",
    "prebuild": "npm run build:slice-map && npm run build:r3-europe-land-mask && npm run build:r3-physical-terrain && npm run build:landmark-miniatures && npm run build:audio && npm run build:motion-comic && npm run build:endings",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/verify-motion-comic-build.mjs && node scripts/verify-title-card-build.mjs && node scripts/verify-ending-assets.mjs",
    "preview": "vite preview",
    "map:fetch-nuts": "node scripts/maps/fetch-nuts.mjs",
    "map:build": "node scripts/maps/build-map.mjs",
    "map:build-admin": "node scripts/maps/build-admin-map.mjs",
    "map:build-strategic": "node scripts/maps/build-strategic-geography.mjs",
    "map:render-strategic": "node scripts/maps/render-strategic-geography.mjs",
    "map:build-terrain": "node scripts/maps/build-terrain-profiles.mjs",
    "map:render-terrain": "node scripts/maps/render-terrain-profiles.mjs",
    "map:build-transport": "node scripts/maps/build-transport-structure.mjs",
    "map:render-transport": "node scripts/maps/render-transport-structure.mjs",
    "systems:build-movement-supply": "node scripts/maps/build-movement-supply-baseline.mjs",
    "simulate:logistics": "node scripts/simulate-logistics-envelope.mjs",
    "simulate:logistics-v0.2": "node scripts/simulate-logistics-envelope-v0.2.mjs",
    "simulate:combat": "node scripts/simulate-combat-balance.mjs",
    "simulate:operational-combat": "node scripts/simulate-operational-combat.mjs",
    "simulate:integrated-campaign": "node scripts/simulate-integrated-campaign.mjs",
    "simulate:modern-formations": "node scripts/simulate-modern-formations.mjs",
    "simulate:escalation-occupation": "node scripts/simulate-escalation-occupation.mjs",
    "simulate:integrated-foundation-v0.2": "node scripts/simulate-integrated-foundation-v0.2.mjs",
    "map:validate": "node scripts/maps/validate-map.mjs"
  },
  "dependencies": {
    "@turf/turf": "^7.2.0",
    "csv-parse": "^6.1.0",
    "d3-geo": "^3.1.1",
    "maplibre-gl": "^6.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shapefile": "^0.6.6",
    "three": "^0.179.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "world-cities-json": "^1.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
